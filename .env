# =============================================================================
# База данных PostgreSQL
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=avito_kitchen
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
DB_SSLMODE=disable

# =============================================================================
# Основной сервис (Core Service)
# =============================================================================
CORE_PORT=8080
# Таймаут ожидания ответа на вебхуки заведений (в секундах)
WEBHOOK_TIMEOUT_SEC=5
# Уровень логирования: debug, info, warn, error
LOG_LEVEL=info
# Формат логирования: json || text
LOG_FORMAT=json

# =============================================================================
# Эмулятор заведения / POS-системы (Parent Service)
# =============================================================================
RESTAURANT_PORT=8081

CORE_SERVICE_URL=http://core-service:8080

RESTAURANT_ID=a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

